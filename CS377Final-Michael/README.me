-- ============================================================
-- PROCEDURE 1 — get_issues_by_publisher
--
--  REQUIREMENTS MET:
--    SELECT, INNER JOIN (x2), WHERE, AS, ORDER BY
--
--  EXTRA FEATURES:
--    LOWER() — used for case-insensitive publisher name matching
--
--  Basic JOIN across 3 tables (issue, series, publisher).
--  Returns all issues for a given publisher name.
-- ============================================================

CREATE OR REPLACE FUNCTION get_issues_by_publisher(p_publisher_name VARCHAR)
RETURNS TABLE (
    publisher     VARCHAR,
    series        VARCHAR,
    issue_number  VARCHAR,
    issue_title   VARCHAR,
    publish_date  DATE,
    cover_price   NUMERIC
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            p.name         AS publisher,
            s.title        AS series,
            i.issue_number AS issue_number,
            i.title        AS issue_title,
            i.publish_date,
            i.cover_price
        FROM issue i
        INNER JOIN series    s ON i.series_id    = s.series_id
        INNER JOIN publisher p ON s.publisher_id = p.publisher_id
        WHERE LOWER(p.name) = LOWER(p_publisher_name)
        ORDER BY s.title, i.publish_date;
END;
$$;

-- USAGE:
--   SELECT * FROM get_issues_by_publisher('Marvel Comics');
--   SELECT * FROM get_issues_by_publisher('DC Comics');


-- ============================================================
-- PROCEDURE 2 — get_creator_credits
--
--  REQUIREMENTS MET:
--    SELECT, INNER JOIN (x3), WHERE, AND, LIMIT, ORDER BY DESC,
--    CONCAT, CONCAT_WS, AS
--
--  EXTRA FEATURES:
--    LOWER() — used for case-insensitive name matching
--
--  Returns every issue a creator worked on and their role.
--  Demonstrates both CONCAT and CONCAT_WS for string building
--  and limits to the 100 most recent credits.
-- ============================================================

CREATE OR REPLACE FUNCTION get_creator_credits(
    p_first_name VARCHAR,
    p_last_name  VARCHAR
)
RETURNS TABLE (
    creator       TEXT,
    creator_ws    TEXT,
    role          VARCHAR,
    series        VARCHAR,
    issue_number  VARCHAR,
    issue_title   VARCHAR,
    publish_date  DATE
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            CONCAT(c.first_name, ' ', c.last_name)     AS creator,
            CONCAT_WS(' ', c.first_name, c.last_name)  AS creator_ws,
            ic.role,
            s.title                                     AS series,
            i.issue_number,
            i.title                                     AS issue_title,
            i.publish_date
        FROM issue_creator ic
        INNER JOIN creator c ON ic.creator_id = c.creator_id
        INNER JOIN issue   i ON ic.issue_id   = i.issue_id
        INNER JOIN series  s ON i.series_id   = s.series_id
        WHERE LOWER(c.first_name) = LOWER(p_first_name)
          AND LOWER(c.last_name)  = LOWER(p_last_name)
        ORDER BY i.publish_date DESC
        LIMIT 100;
END;
$$;

-- USAGE:
--   SELECT * FROM get_creator_credits('Stan', 'Lee');
--   SELECT * FROM get_creator_credits('Alan', 'Moore');


-- ============================================================
-- PROCEDURE 3 — search_characters_by_name
--
--  REQUIREMENTS MET:
--    SELECT, WHERE, LIKE '%' wildcard, LIKE '_' wildcard, OR,
--    AS, ORDER BY, REPLACE, REVERSE, LENGTH, LENGTH(TRIM()),
--    SUBSTR, LEFT, RIGHT, POSITION
--
--  EXTRA FEATURES:
--    LOWER() — used inside POSITION() for case-insensitive search
--
--  Searches characters by a partial name pattern and returns
--  a rich set of string-function results on the name column.
--  Pass a search term and it will match anywhere in the name.
-- ============================================================

CREATE OR REPLACE FUNCTION search_characters_by_name(p_search VARCHAR)
RETURNS TABLE (
    character_name   VARCHAR,
    alignment        VARCHAR,
    name_replaced    TEXT,
    name_reversed    TEXT,
    name_length      INT,
    name_trimmed_len INT,
    name_substr      TEXT,
    name_left4       TEXT,
    name_right4      TEXT,
    pos_of_a         INT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            ch.name                                        AS character_name,
            ch.alignment,
            REPLACE(ch.name::TEXT, 'man', 'person')        AS name_replaced,
            REVERSE(ch.name::TEXT)                         AS name_reversed,
            LENGTH(ch.name::TEXT)                          AS name_length,
            LENGTH(TRIM(ch.name::TEXT))                    AS name_trimmed_len,
            SUBSTR(ch.name::TEXT, 1, 5)                    AS name_substr,
            LEFT(ch.name::TEXT, 4)                         AS name_left4,
            RIGHT(ch.name::TEXT, 4)                        AS name_right4,
            POSITION('a' IN LOWER(ch.name::TEXT))          AS pos_of_a
        FROM character ch
        WHERE ch.name LIKE '%' || p_search || '%'   -- % wildcard: match anywhere
           OR ch.name LIKE p_search || '_'           -- _ wildcard: one extra char after term
        ORDER BY ch.name;
END;
$$;

-- USAGE:
--   SELECT * FROM search_characters_by_name('man');
--   SELECT * FROM search_characters_by_name('Ultra');
--   SELECT * FROM search_characters_by_name('Iron');


-- ============================================================
-- PROCEDURE 4 — get_story_arc_issues
--
--  REQUIREMENTS MET:
--    SELECT, INNER JOIN (x3), LEFT JOIN (x2), WHERE, LIKE '%',
--    COALESCE, AS, ORDER BY
--
--  EXTRA FEATURES:
--    LOWER() — used for case-insensitive arc title matching
--
--  Returns every issue in a story arc with creator credits.
--  COALESCE handles issues that have no creator on record.
--  Uses partial LIKE matching so you can pass part of a title.
-- ============================================================

CREATE OR REPLACE FUNCTION get_story_arc_issues(p_arc_title VARCHAR)
RETURNS TABLE (
    arc_title    VARCHAR,
    part_num     SMALLINT,
    issue_title  VARCHAR,
    publish_date DATE,
    series       VARCHAR,
    creator      TEXT,
    role         TEXT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            sa.title                                                   AS arc_title,
            isa.part_num,
            i.title                                                    AS issue_title,
            i.publish_date,
            s.title                                                    AS series,
            COALESCE(cr.first_name || ' ' || cr.last_name, 'Unknown') AS creator,
            COALESCE(ic.role::TEXT, 'N/A')                             AS role
        FROM issue_story_arc isa
        INNER JOIN story_arc     sa ON isa.arc_id     = sa.arc_id
        INNER JOIN issue          i ON isa.issue_id   = i.issue_id
        INNER JOIN series         s ON i.series_id    = s.series_id
        LEFT JOIN  issue_creator ic ON i.issue_id     = ic.issue_id
        LEFT JOIN  creator       cr ON ic.creator_id  = cr.creator_id
        WHERE LOWER(sa.title) LIKE LOWER('%' || p_arc_title || '%')
        ORDER BY isa.part_num, ic.role;
END;
$$;

-- USAGE (pass a partial title — LIKE '%...%' will match it):
--   SELECT * FROM get_story_arc_issues('Dark');
--   SELECT * FROM get_story_arc_issues('Fall');
--   SELECT * FROM get_story_arc_issues('War');


-- ============================================================
-- PROCEDURE 5 — summarize_publisher_stats
--
--  REQUIREMENTS MET:
--    SELECT, LEFT JOIN (x2), GROUP BY, ROLLUP, COUNT(), SUM(),
--    AVG(), MIN(), MAX(), ORDER BY DESC, COALESCE, AS
--
--  EXTRA FEATURES:
--    DISTINCT  — used inside COUNT(DISTINCT ...) to avoid duplicates
--    ROUND()   — rounds avg cover price to 2 decimal places
--
--  Returns a statistical summary per publisher, plus a grand
--  total row produced by ROLLUP. COALESCE labels that row.
-- ============================================================

CREATE OR REPLACE FUNCTION summarize_publisher_stats()
RETURNS TABLE (
    publisher       TEXT,
    total_series    BIGINT,
    total_issues    BIGINT,
    total_revenue   NUMERIC,
    avg_cover_price NUMERIC,
    cheapest_issue  NUMERIC,
    priciest_issue  NUMERIC,
    earliest_issue  DATE,
    latest_issue    DATE
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            COALESCE(p.name::TEXT, '*** GRAND TOTAL ***') AS publisher,
            COUNT(DISTINCT s.series_id)                    AS total_series,
            COUNT(DISTINCT i.issue_id)                     AS total_issues,
            SUM(i.cover_price)                             AS total_revenue,
            ROUND(AVG(i.cover_price), 2)                   AS avg_cover_price,
            MIN(i.cover_price)                             AS cheapest_issue,
            MAX(i.cover_price)                             AS priciest_issue,
            MIN(i.publish_date)                            AS earliest_issue,
            MAX(i.publish_date)                            AS latest_issue
        FROM publisher p
        LEFT JOIN series s ON p.publisher_id = s.publisher_id
        LEFT JOIN issue  i ON s.series_id    = i.series_id
        GROUP BY ROLLUP(p.name)
        ORDER BY total_issues DESC;
END;
$$;

-- USAGE:
--   SELECT * FROM summarize_publisher_stats();


-- ============================================================
-- PROCEDURE 6 — add_issue  (PROCEDURE — modifies data)
--
--  REQUIREMENTS MET:
--    INSERT, SELECT, WHERE, AS
--
--  EXTRA FEATURES:
--    DECLARE         — declares the v_series_title local variable
--    RAISE EXCEPTION — thrown if series ID does not exist
--    RAISE NOTICE    — confirms successful insert to the console
--
--  Adds a new issue to an existing series.
--  Validates that the series exists before inserting.
-- ============================================================

CREATE OR REPLACE PROCEDURE add_issue(
    p_series_id    INT,
    p_issue_number VARCHAR,
    p_title        VARCHAR,
    p_publish_date DATE,
    p_cover_price  NUMERIC,
    p_page_count   SMALLINT,
    p_notes        TEXT DEFAULT NULL
)
LANGUAGE plpgsql AS $$
DECLARE
    v_series_title VARCHAR;
BEGIN
    SELECT title AS series_title
    INTO v_series_title
    FROM series
    WHERE series_id = p_series_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Series ID % does not exist.', p_series_id;
    END IF;

    INSERT INTO issue (series_id, issue_number, title, publish_date, cover_price, page_count, notes)
    VALUES (p_series_id, p_issue_number, p_title, p_publish_date, p_cover_price, p_page_count, p_notes);

    RAISE NOTICE 'Issue "%" (#%) added to series "%".', p_title, p_issue_number, v_series_title;
END;
$$;

-- USAGE:
--   CALL add_issue(1, '301', 'The New Age Begins', '2024-06-01', 4.99, 32, 'Start of a new chapter.');
--   CALL add_issue(999, '1', 'Bad Insert', '2024-01-01', 3.99, 24);  -- raises error


