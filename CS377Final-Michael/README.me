-- PROCEDURE 8 — delete_creator_credits  (PROCEDURE — modifies data)
--
--  REQUIREMENTS MET:
--    DELETE, SELECT, WHERE, CONCAT, AS
--
--  EXTRA FEATURES:
--    DECLARE         — declares v_name and v_deleted_count variables
--    GET DIAGNOSTICS — captures the number of deleted rows
--    RAISE EXCEPTION — thrown if creator ID does not exist
--    RAISE NOTICE    — reports how many rows were removed
--    LOWER()         — used inside CONCAT for name formatting
--
--  Removes all issue_creator rows for a given creator ID.
--  Reports how many rows were deleted via GET DIAGNOSTICS.
-- ============================================================

CREATE OR REPLACE PROCEDURE delete_creator_credits(p_creator_id INT)
LANGUAGE plpgsql AS $$
DECLARE
    v_name          TEXT;
    v_deleted_count INT;
BEGIN
    SELECT CONCAT(first_name, ' ', last_name) AS full_name
    INTO v_name
    FROM creator
    WHERE creator_id = p_creator_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Creator ID % does not exist.', p_creator_id;
    END IF;

    DELETE FROM issue_creator
    WHERE creator_id = p_creator_id;

    GET DIAGNOSTICS v_deleted_count = ROW_COUNT;

    RAISE NOTICE 'Removed % credit(s) for creator "%" (ID %).', v_deleted_count, v_name, p_creator_id;
END;
$$;

-- USAGE:
--   CALL delete_creator_credits(5);
--   CALL delete_creator_credits(999);  -- raises error


-- ============================================================
-- PROCEDURE 9 — get_issues_with_character_count
--
--  REQUIREMENTS MET:
--    SELECT, INNER JOIN (x2), GROUP BY, HAVING, COUNT(),
--    SUM(), ORDER BY DESC, AS
--
--  EXTRA FEATURES:
--    (none — all features used are from the required list)
--
--  Returns issues featuring at least N characters.
--  Also sums total page count across matching issues.
--  Useful for identifying large crossover or event issues.
-- ============================================================

CREATE OR REPLACE FUNCTION get_issues_with_character_count(p_min_characters INT DEFAULT 3)
RETURNS TABLE (
    issue_id        INT,
    issue_title     VARCHAR,
    series          VARCHAR,
    publish_date    DATE,
    character_count BIGINT,
    total_pages     BIGINT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            i.issue_id,
            i.title                AS issue_title,
            s.title                AS series,
            i.publish_date,
            COUNT(ic.character_id) AS character_count,
            SUM(i.page_count)      AS total_pages
        FROM issue i
        INNER JOIN series          s  ON i.series_id  = s.series_id
        INNER JOIN issue_character ic ON i.issue_id   = ic.issue_id
        GROUP BY i.issue_id, i.title, s.title, i.publish_date
        HAVING COUNT(ic.character_id) >= p_min_characters
        ORDER BY character_count DESC;
END;
$$;

-- USAGE:
--   SELECT * FROM get_issues_with_character_count(3);
--   SELECT * FROM get_issues_with_character_count(5);


-- ============================================================
-- PROCEDURE 10 — transfer_series_to_publisher  (PROCEDURE — modifies data)
--
--  REQUIREMENTS MET:
--    UPDATE, SELECT, WHERE, COUNT(), AS
--
--  EXTRA FEATURES:
--    DECLARE         — declares v_from_name, v_to_name, v_series_count
--    RAISE EXCEPTION — thrown for bad publisher IDs or self-transfer
--    RAISE NOTICE    — confirms how many series were transferred
--
--  Bulk-moves all series from one publisher to another,
--  simulating a real-world licence transfer or acquisition.
--  Validates both publisher IDs and guards against self-transfer.
-- ============================================================

CREATE OR REPLACE PROCEDURE transfer_series_to_publisher(
    p_from_publisher_id INT,
    p_to_publisher_id   INT
)
LANGUAGE plpgsql AS $$
DECLARE
    v_from_name    VARCHAR;
    v_to_name      VARCHAR;
    v_series_count INT;
BEGIN
    SELECT name AS publisher_name
    INTO v_from_name
    FROM publisher
    WHERE publisher_id = p_from_publisher_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Source publisher ID % does not exist.', p_from_publisher_id;
    END IF;

    SELECT name AS publisher_name
    INTO v_to_name
    FROM publisher
    WHERE publisher_id = p_to_publisher_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Destination publisher ID % does not exist.', p_to_publisher_id;
    END IF;

    IF p_from_publisher_id = p_to_publisher_id THEN
        RAISE EXCEPTION 'Source and destination publisher cannot be the same.';
    END IF;

    SELECT COUNT(*) AS series_count
    INTO v_series_count
    FROM series
    WHERE publisher_id = p_from_publisher_id;

    IF v_series_count = 0 THEN
        RAISE NOTICE 'Publisher "%" has no series to transfer.', v_from_name;
        RETURN;
    END IF;

    UPDATE series
    SET publisher_id = p_to_publisher_id
    WHERE publisher_id = p_from_publisher_id;

    RAISE NOTICE 'Transferred % series from "%" to "%".', v_series_count, v_from_name, v_to_name;
END;
$$;

-- USAGE:
--   CALL transfer_series_to_publisher(3, 1);    -- move Image series to Marvel
--   CALL transfer_series_to_publisher(999, 1);  -- raises error (bad source ID)
--   CALL transfer_series_to_publisher(1, 1);    -- raises error (same publisher)


-- ============================================================
-- PROCEDURE 11 — get_creator_string_analysis
--
--  REQUIREMENTS MET:
--    SELECT, WHERE, LIKE '_' wildcard, LIKE '%' wildcard, OR,
--    REPLACE, REVERSE, LENGTH, LENGTH(TRIM()), SUBSTR,
--    LEFT, RIGHT, POSITION, AS, ORDER BY
--
--  EXTRA FEATURES:
--    LOWER() — used inside POSITION() for case-insensitive search
--
--  Returns string-function breakdowns for creators whose
--  last name matches a wildcard pattern or contains the
--  search term anywhere within it.
-- ============================================================

CREATE OR REPLACE FUNCTION get_creator_string_analysis(p_search VARCHAR)
RETURNS TABLE (
    full_name       TEXT,
    name_replaced   TEXT,
    name_reversed   TEXT,
    name_length     INT,
    trimmed_length  INT,
    name_substr_1_5 TEXT,
    first_4_chars   TEXT,
    last_4_chars    TEXT,
    pos_of_e        INT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            CONCAT(c.first_name, ' ', c.last_name)  AS full_name,
            REPLACE(c.last_name, 'son', 'SON')       AS name_replaced,
            REVERSE(c.last_name)                     AS name_reversed,
            LENGTH(c.last_name)                      AS name_length,
            LENGTH(TRIM(c.last_name))                AS trimmed_length,
            SUBSTR(c.last_name, 1, 5)                AS name_substr_1_5,
            LEFT(c.last_name, 4)                     AS first_4_chars,
            RIGHT(c.last_name, 4)                    AS last_4_chars,
            POSITION('e' IN LOWER(c.last_name))      AS pos_of_e
        FROM creator c
        WHERE c.last_name LIKE p_search || '_'        -- '_' matches exactly one extra char
           OR c.last_name LIKE '%' || p_search || '%' -- '%' matches anywhere in name
        ORDER BY c.last_name;
END;
$$;

-- USAGE:
--   SELECT * FROM get_creator_string_analysis('Smith');
--   SELECT * FROM get_creator_string_analysis('John');


-- ============================================================
-- PROCEDURE 12 — get_issue_rankings
--
--  REQUIREMENTS MET:
--    SELECT, INNER JOIN, WITH AS (CTE), OVER, ORDER BY DESC,
--    ROW_NUMBER(), RANK(), DENSE_RANK(), LAG(), LEAD(), AS
--
--  EXTRA FEATURES:
--    PARTITION BY — divides window function results per series
--                   so rankings reset for each series rather
--                   than running across the whole table
--
--  Uses a CTE to pre-aggregate the base data, then applies
--  window functions to rank issues by cover price within each
--  series, and shows the previous/next price via LAG/LEAD.
-- ============================================================

CREATE OR REPLACE FUNCTION get_issue_rankings()
RETURNS TABLE (
    series            VARCHAR,
    issue_title       VARCHAR,
    cover_price       NUMERIC,
    publish_date      DATE,
    row_num           BIGINT,
    price_rank        BIGINT,
    dense_price_rank  BIGINT,
    prev_price        NUMERIC,
    next_price        NUMERIC
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        WITH issue_base AS (
            SELECT
                s.title        AS series_title,
                i.title        AS issue_title,
                i.cover_price,
                i.publish_date
            FROM issue i
            INNER JOIN series s ON i.series_id = s.series_id
        )
        SELECT
            ib.series_title                                                                    AS series,
            ib.issue_title,
            ib.cover_price,
            ib.publish_date,
            ROW_NUMBER()  OVER (PARTITION BY ib.series_title ORDER BY ib.cover_price DESC)    AS row_num,
            RANK()        OVER (PARTITION BY ib.series_title ORDER BY ib.cover_price DESC)    AS price_rank,
            DENSE_RANK()  OVER (PARTITION BY ib.series_title ORDER BY ib.cover_price DESC)    AS dense_price_rank,
            LAG(ib.cover_price)  OVER (PARTITION BY ib.series_title ORDER BY ib.publish_date) AS prev_price,
            LEAD(ib.cover_price) OVER (PARTITION BY ib.series_title ORDER BY ib.publish_date) AS next_price
        FROM issue_base ib
        ORDER BY ib.series_title, ib.cover_price DESC;
END;
$$;

-- USAGE:
--   SELECT * FROM get_issue_rankings();
--   SELECT * FROM get_issue_rankings() WHERE series = 'The Amazing Warriors';


-- ============================================================
-- PROCEDURE 13 — get_genre_cross_publisher
--
--  REQUIREMENTS MET:
--    SELECT, CROSS JOIN, LEFT JOIN, GROUP BY, HAVING,
--    COUNT(), AS, ORDER BY DESC
--
--  EXTRA FEATURES:
--    DISTINCT — used in the subquery to get unique genres
--               without duplicates across the series table
--
--  Uses a CROSS JOIN to produce every possible combination
--  of publisher and genre, then filters to combinations that
--  actually exist — useful for reporting which publishers
--  cover which genres.
-- ============================================================

CREATE OR REPLACE FUNCTION get_genre_cross_publisher()
RETURNS TABLE (
    publisher    VARCHAR,
    genre        VARCHAR,
    series_count BIGINT
)
LANGUAGE plpgsql AS $$
BEGIN
    RETURN QUERY
        SELECT
            p.name             AS publisher,
            genre_list.genre,
            COUNT(s.series_id) AS series_count
        FROM publisher p
        CROSS JOIN (
            SELECT DISTINCT s2.genre
            FROM series s2
            WHERE s2.genre IS NOT NULL
        ) AS genre_list
        LEFT JOIN series s
               ON s.publisher_id = p.publisher_id
              AND s.genre        = genre_list.genre
        GROUP BY p.name, genre_list.genre
        HAVING COUNT(s.series_id) > 0
        ORDER BY p.name, series_count DESC;
END;
$$;

-- USAGE:
--   SELECT * FROM get_genre_cross_publisher();
--   SELECT * FROM get_genre_cross_publisher() WHERE genre = 'Horror';


-- ============================================================
-- VIEW 1 — v_publisher_series_summary
--
--  REQUIREMENTS MET:
--    VIEW, SELECT, LEFT JOIN (x2), GROUP BY, COUNT(), AS,
--    ORDER BY DESC
--
--  EXTRA FEATURES:
--    DISTINCT — used inside COUNT(DISTINCT ...) to avoid
--               counting duplicate series or issue records
--
--  A reusable view showing how many series and issues each
--  publisher has, without writing the full JOIN every time.
-- ============================================================

CREATE OR REPLACE VIEW v_publisher_series_summary AS
    SELECT
        p.name                       AS publisher,
        COUNT(DISTINCT s.series_id)  AS total_series,
        COUNT(DISTINCT i.issue_id)   AS total_issues
    FROM publisher p
    LEFT JOIN series s ON p.publisher_id = s.publisher_id
    LEFT JOIN issue  i ON s.series_id    = i.series_id
    GROUP BY p.name
    ORDER BY total_issues DESC;

-- USAGE:
--   SELECT * FROM v_publisher_series_summary;
--   SELECT * FROM v_publisher_series_summary WHERE total_issues > 100;


-- ============================================================
-- VIEW 2 — v_character_appearance_summary
--
--  REQUIREMENTS MET:
--    VIEW, SELECT, RIGHT JOIN, LEFT JOIN, COALESCE,
--    COUNT(), GROUP BY, ORDER BY DESC, AS
--
--  EXTRA FEATURES:
--    (none — all features used are from the required list)
--
--  Shows every character alongside their total appearances.
--  RIGHT JOIN ensures characters with zero appearances still
--  appear in the results with a count of 0.
-- ============================================================

CREATE OR REPLACE VIEW v_character_appearance_summary AS
    SELECT
        COALESCE(ch.name, 'Unknown') AS character_name,
        ch.alignment,
        p.name                       AS publisher,
        COUNT(ic.issue_id)           AS total_appearances
    FROM issue_character ic
    RIGHT JOIN character  ch ON ic.character_id = ch.character_id
    LEFT JOIN  publisher   p ON ch.publisher_id = p.publisher_id
    GROUP BY ch.name, ch.alignment, p.name
    ORDER BY total_appearances DESC;

-- USAGE:
--   SELECT * FROM v_character_appearance_summary;
--   SELECT * FROM v_character_appearance_summary WHERE alignment = 'Villain';


